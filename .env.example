# Authored by: Mohit Singh
#
# Template for local development. Copy to .env and adjust if needed — .env is gitignored,
# this file is the tracked reference for every var the system uses across all phases.
# Docker Compose reads this file's shape via docker-compose.yml's ${VAR:-default} syntax;
# most defaults below already match docker-compose.yml, so a plain `docker compose up`
# works without even creating a .env file for local dev.

# --- Database (new, dedicated instance for this project — never shared with another project) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_DB=master_db_crawler
# In-network hostname is "postgres" (the compose service name); from the host machine the
# same database is reachable at localhost:5436 (host port — see docker-compose.yml; 5432-5435
# were already taken by other local projects on the dev host this was built on, so pick
# whatever's actually free on yours and update the mapping if 5436 collides too).
DATABASE_URL=postgresql://postgres:1234@postgres:5432/master_db_crawler

# --- Backend API (backend/api) ---
NODE_ENV=development
PORT=4000
# Host port is 4010 (container's own PORT stays 4000) — 4000 was already taken by another
# local project's dev server on the host this was built on.
LOG_LEVEL=info
# Added in Phase 2 (auth): JWT_SECRET=
# COOKIE_SECURE=true|false — optional, overrides the NODE_ENV-derived default. Needed because
# a Secure cookie requires real HTTPS; docker-compose.yml sets this to "false" since it has no
# TLS termination. Only set true once this stack sits behind HTTPS. See config.ts.

# --- Backend worker (backend/worker) ---
ENVIRONMENT=development
# Added in Phase 3 (discovery): OVERPASS_URL=, NOMINATIM_URL=
# Added in Phase 4 (enrichment): PROXY_URL= (optional, for anti-bot-blocked sites; also
# respect_robots_txt/request_delay_ms/retry_count are DB-side crawl_settings, not env vars)

# Phase 5 — AI extraction (optional, provider-agnostic; see backend/worker/business_scout_worker/
# llm.py). The actual on/off switch is the DB-side `crawl_settings.use_ai_extraction` (toggled
# from the Settings screen) — these env vars only configure WHERE to send the call when it's on.
# Absent LLM_BASE_URL means AI extraction is unreachable even with the DB toggle on, and every
# dynamic-field extraction silently no-ops (never blocks or fails a crawl). Point LLM_BASE_URL at
# any OpenAI-compatible /v1/chat/completions endpoint — a local Ollama (free) is the default below;
# swap to Gemini's OpenAI-compat endpoint or OpenAI itself by changing these three vars only.
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# LLM_TIMEOUT_S=30
# LLM_MAX_TOKENS=500

# --- Manual Google enrichment (Phase 6 — on-demand per-business button, never automatic) ---
# Absent = the "Fetch rating" button is hidden/disabled; everything else still works.
# GOOGLE_API_KEY=

# --- Exports (Phase 7 — xlsx/csv/json generation + history) ---
# EXPORTS_DIR — where generated files live; docker-compose.yml mounts a named volume here so
# they survive a container restart. Local (non-Docker) dev defaults to a repo-relative path.
# EXPORTS_DIR=./data/exports
# EXPORT_RETENTION_DAYS=7

# --- Public API for external consumers (Phase 7) ---
# API_KEYS — comma-separated static keys authenticating GET /api/v1/businesses (never the
# frontend's cookie-based JWT session). Absent = every /api/v1 request is rejected with 401.
# Consumers send Authorization: Bearer <key> or X-API-Key: <key>. Spec: GET /api/v1/openapi.json
# (unauthenticated, so a prospective consumer can see the contract before they have a key).
# API_KEYS=key-for-myhub,key-for-partner-x

# --- Crawl (OCR) module — Google Maps screenshot capture + Tesseract OCR ---
# Captured PNGs live under OCR_CAPTURES_DIR (docker-compose mounts a named volume there);
# purged after OCR_CRAWL_RETENTION_DAYS while DB rows persist. Headless in the container (no
# display); run headful only for local, attended dev. Requires the `tesseract-ocr` binary
# (apt-installed in backend/Dockerfile; local Windows dev: UB-Mannheim installer + TESSERACT_CMD).
# See md/OCR_CRAWL.md. ⚠️ Automating Google Maps violates its ToS — low-volume/internal use only;
# the compliant alternative for the same data (minus email) is the Google Places API.
# OCR_CAPTURES_DIR=./storage/ocr_captures
# OCR_CRAWL_RETENTION_DAYS=5
# OCR_CRAWL_MAX_RESULTS=25
# OCR_CRAWL_HEADLESS=true         # worker: false to watch the browser during local dev
# OCR_DEVICE_SCALE=2              # the OCR-readability lever (2x DPI) — do not lower
# TESSERACT_CMD=                  # local dev only: absolute path to tesseract.exe if not on PATH
# OCR_CONCURRENCY=3               # how many businesses' Tesseract OCR (Stage B) run at once —
                                   # each call stays single-threaded internally (OMP_THREAD_LIMIT=1,
                                   # set in docker-compose.yml); this is the knob that uses multiple
                                   # CPU cores across a batch

# --- Frontend ---
# BACKEND_URL (compose-internal hostname, e.g. http://backend:4000) is set directly in
# docker-compose.yml — it's reserved for any future server-side (SSR) use, not consumed yet.
#
# VITE_API_URL is different and more important: the BROWSER (client-side JS) cannot resolve
# the Docker-internal hostname "backend" at all — it needs a URL it can actually reach, and
# Vite bakes VITE_-prefixed vars into the client bundle at BUILD time, not container start
# time. Default below matches docker-compose.yml's host port mapping (see the Database section
# above for why 4010, not 4000). Passed as a Docker build-arg for the frontend image — see
# Dockerfile and docker-compose.yml's frontend.build.args.
VITE_API_URL=http://localhost:4010
