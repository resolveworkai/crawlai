# Copy to .env and fill in — never commit the real file (already gitignored).

# The Marketing API this agent talks to (backend/api), and the operator account it sends as.
API_BASE_URL=http://localhost:4010
API_EMAIL=you@example.com
API_PASSWORD=your-password

# Guardrails against WhatsApp rate-limiting/banning the number — see README.md before changing.
MIN_DELAY_MS=25000
MAX_DELAY_MS=50000
DAILY_CAP=40

# `npm run test-send` sends ONE trial message here — do this before ever running a real campaign,
# to confirm the automation actually works. Defaults to the number used during development.
TEST_PHONE_NUMBER=+919560397112

# Only used by `npm run agent` (the local control server the campaign page's
# "Start Automated Send" button calls). Must match the frontend's own origin.
AGENT_PORT=8787
CORS_ORIGIN=http://localhost:3000
