{
  "name": "business-scout-ai-whatsapp-sender",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-only WhatsApp automation agent for the Marketing tool. Runs on the operator's own machine, never deployed to the shared Docker stack. See README.md before use.",
  "scripts": {
    "agent": "tsx watch --clear-screen=false src/agent.ts",
    "agent:no-watch": "tsx src/agent.ts",
    "send": "tsx src/send.ts",
    "test-send": "tsx src/testSend.ts",
    "dev:with-backend": "concurrently -n backend,agent -c blue,magenta \"npm --prefix ../api run dev\" \"npm run agent\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.16.5",
    "concurrently": "^9.1.2",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.10"
  }
}
